<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>sip</AssemblyName>
    <RootNamespace>Sip</RootNamespace>
    <Version>2.0.0</Version>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- 排除测试工程,避免 SDK 默认 Glob 把 tests/**/*.cs 编进主程序 -->
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
    <!-- 语言文件默认外置（发布时复制到 exe 旁 languages/，可编辑定制） -->
    <None Include="languages\**\*.json" />
    <!-- 同时内嵌为程序集资源，单文件即自带官方翻译：数据目录缺失时自动恢复 -->
    <EmbeddedResource Include="languages\**\*.json">
      <LogicalName>sip-lang.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- 内嵌 Web UI (sip start server): 单文件自带，无外部静态目录依赖 -->
    <EmbeddedResource Include="web\index.html">
      <LogicalName>sip-web.index.html</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="web\login.html">
      <LogicalName>sip-web.login.html</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="web\login-bg.png">
      <LogicalName>sip-web.login-bg.png</LogicalName>
    </EmbeddedResource>
    <!-- 前端脚本外置（不再是 <script> 内联块）：CSP 的 script-src 'self' 不允许内联脚本，
         拆出来的同时把「正文里混进 <script>」这条 XSS 路径在浏览器层面也堵死。 -->
    <EmbeddedResource Include="web\app.js">
      <LogicalName>sip-web.app.js</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="web\login.js">
      <LogicalName>sip-web.login.js</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="web\sw.js">
      <LogicalName>sip-web.sw.js</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="web\icon.svg">
      <LogicalName>sip-web.icon.svg</LogicalName>
    </EmbeddedResource>
    <!-- 注意 LogicalName 必须显式写：默认的 %(Filename)%(Extension) 会得到
         sip-web.manifest.webmanifest，与 Web.cs 里查的名字对不上 -->
    <EmbeddedResource Include="web\manifest.webmanifest">
      <LogicalName>sip-web.manifest</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- 语言文件用自定义复制（不走 CopyToOutputDirectory/CopyToPublishDirectory，避免单文件发布的 MSB3094 冲突）：
       Build 后复制到 bin，Publish 后复制到发布目录 -->
  <Target Name="CopyLanguagesToOutput" AfterTargets="Build">
    <ItemGroup>
      <_LangFiles Include="languages\**\*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_LangFiles)" DestinationFolder="$(OutputPath)languages\" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyLanguagesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_LangFiles Include="languages\**\*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_LangFiles)" DestinationFolder="$(PublishDir)languages\" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="CodeHollow.FeedReader" Version="1.2.6" />
    <PackageReference Include="DiffPlex" Version="1.7.2" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="ktsu.CredentialCache" Version="1.3.19" />
    <!-- SQLCipher(挡位 3 加密)已移除,原先把 Microsoft.Data.Sqlite 压到 9.x 的理由随之消失。
         但版本这次不动:升 10.x 会连带换 SQLitePCLRaw 大版本,属于独立改动,单独验证后再动。 -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.11" />
    <!-- 混版修复:core + 原生库 lib.e_sqlite3 升 2.1.13(2.1.x 修复末版,消 GHSA-2m69-gcr7-jv3q)。
         原先 bundle 停在 2.1.11 是为了迁就 SQLCipher provider 的版本上限,该约束已随加密移除而消失;
         这次仍不动版本,避免把「删功能」和「升依赖」混进同一次提交。 -->
    <PackageReference Include="SQLitePCLRaw.core" Version="2.1.13" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    <PackageReference Include="Terminal.Gui" Version="2.4.17" />
    <!-- 图片解码:Terminal.Gui 自带 sixel 编码器但**不带解码器**,
         需要先把 RSS 里的 PNG/JPEG/GIF/WebP 解成像素才能编码。
         锁 3.1.x:Apache-2.0;4.x 起换成 SixLabors 分叉协议,商用有额外限制 -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

</Project>