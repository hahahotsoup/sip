<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>sip</AssemblyName>
    <RootNamespace>Sip</RootNamespace>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- 语言文件默认外置（发布时复制到 exe 旁 languages/，可编辑定制） -->
    <None Include="languages\**\*.json" />
    <!-- 同时内嵌为程序集资源，单文件即自带官方翻译：数据目录缺失时自动恢复 -->
    <EmbeddedResource Include="languages\**\*.json">
      <LogicalName>sip-lang.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- 语言文件用自定义复制（不走 CopyToOutputDirectory/CopyToPublishDirectory，避免单文件发布的 MSB3094 冲突）：
       Build 后复制到 bin，Publish 后复制到发布目录 -->
  <Target Name="CopyLanguagesToOutput" AfterTargets="Build">
    <ItemGroup>
      <_LangFiles Include="languages\**\*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_LangFiles)" DestinationFolder="$(OutputPath)languages\" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyLanguagesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_LangFiles Include="languages\**\*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_LangFiles)" DestinationFolder="$(PublishDir)languages\" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="CodeHollow.FeedReader" Version="1.2.6" />
    <PackageReference Include="DiffPlex" Version="1.7.2" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="ktsu.CredentialCache" Version="1.3.19" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0-preview.3.25171.6" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="SQLitePCLRaw.core" Version="3.0.3" />
    <PackageReference Include="Terminal.Gui" Version="2.4.17" />
  </ItemGroup>

</Project>